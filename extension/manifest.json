{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "OpenEcho",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:18440/*",
    "http://127.0.0.1:19450/*",
    "http://127.0.0.1:19452/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup/index.html"
  }
}
